; Engine configuration file.
; NHL 94 native Godot 4 rebuild. See ../GODOT_TODO.md.
; Input actions come from tools/setup_input_map.gd.

config_version=5

[application]

config/name="NHL 94 Native"
config/description="Native Godot 4 rebuild of NHL 94 (Genesis). No emulation."
run/main_scene="res://ui/title_screen.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Sim="*res://core/sim.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=224
window/size/window_width_override=960
window/size/window_height_override=672
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/nhl94_debug/plugin.cfg")

